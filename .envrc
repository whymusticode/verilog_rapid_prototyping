
# Nix dev toolchain (Python + Anthropic SDK) from flake.nix.
use flake

# Load secrets / local overrides from .env (gitignored). direnv's dotenv
# parses plain KEY=value lines and exports them, so no `export` in .env.
dotenv_if_exists .env

# ---- Vivado backend ----
# Discriminates how vivado is invoked on this machine.
# One of: native | flatpak | docker. Leave unset (or set to "auto") to auto-detect.
# Override by exporting VIVADO_BACKEND (or any *_BIN below) before sourcing this file.

# Locate a native install: prefer something already on PATH, otherwise scan the
# usual Xilinx/AMD roots and keep the newest version found (glob expands sorted,
# so the last match wins). Only set a *_BIN var once an executable is found.
if [ -z "${VIVADO_NATIVE_BIN:-}" ]; then
  command -v vivado >/dev/null 2>&1 && VIVADO_NATIVE_BIN="$(command -v vivado)"
  for _b in /opt/Xilinx/Vivado/*/bin/vivado /tools/Xilinx/Vivado/*/bin/vivado \
            /opt/AMD/Vivado/*/bin/vivado "$HOME"/Xilinx/Vivado/*/bin/vivado; do
    [ -x "$_b" ] && VIVADO_NATIVE_BIN="$_b"
  done
fi
if [ -z "${VITIS_HLS_BIN:-}" ]; then
  command -v vitis_hls >/dev/null 2>&1 && VITIS_HLS_BIN="$(command -v vitis_hls)"
  for _b in /opt/Xilinx/Vitis_HLS/*/bin/vitis_hls /tools/Xilinx/Vitis_HLS/*/bin/vitis_hls \
            /opt/AMD/Vitis_HLS/*/bin/vitis_hls "$HOME"/Xilinx/Vitis_HLS/*/bin/vitis_hls; do
    [ -x "$_b" ] && VITIS_HLS_BIN="$_b"
  done
fi
unset _b

if [ -z "${VIVADO_BACKEND:-}" ] || [ "${VIVADO_BACKEND}" = "auto" ]; then
  if [ -n "${VIVADO_NATIVE_BIN:-}" ] && command -v "${VIVADO_NATIVE_BIN}" >/dev/null 2>&1; then
    export VIVADO_BACKEND=native
  elif command -v flatpak >/dev/null 2>&1 && \
       flatpak info "${VIVADO_FLATPAK_APP:-com.github.corna.Vivado}" >/dev/null 2>&1; then
    export VIVADO_BACKEND=flatpak
  elif command -v docker >/dev/null 2>&1; then
    export VIVADO_BACKEND=docker
  else
    unset VIVADO_BACKEND
  fi
fi

[ -n "${VIVADO_NATIVE_BIN:-}" ] && export VIVADO_NATIVE_BIN
[ -n "${VITIS_HLS_BIN:-}" ] && export VITIS_HLS_BIN
export VIVADO_FLATPAK_APP="${VIVADO_FLATPAK_APP:-com.github.corna.Vivado}"
export VIVADO_DOCKER_IMAGE="${VIVADO_DOCKER_IMAGE:-vivado-vitis-2024.1.1:local}"
export VIVADO_DOCKER_PLATFORM="${VIVADO_DOCKER_PLATFORM:-linux/amd64}"
export VIVADO_DOCKER_BIN="${VIVADO_DOCKER_BIN:-/opt/Xilinx/Vivado/2024.1/bin/vivado}"

